# ==========================================
# Lioc B2B Platform - Production Environment Template
# Copy this file to .env and fill in real production secrets
# ==========================================

# Environment & Debug
ENVIRONMENT=production
DEBUG=False

# Project Metadata
PROJECT_NAME="Lioc B2B Platform API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL in Production, SQLite in Dev)
DATABASE_URL=postgresql://lioc_prod_user:YOUR_STRONG_DB_PASSWORD@postgres:5432/lioc_production_db
# For Local Dev: DATABASE_URL=sqlite:///./lioc.db

# Security & Authentication (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=GENERATE_A_64_CHAR_RANDOM_HEX_SECRET_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CEO Executive Admin Credentials
ADMIN_EMAIL=lioccalcutta@gmail.com
# Use: python scripts/generate_password_hash.py to generate a PBKDF2 hash
ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$YOUR_SALT$YOUR_HASH
ADMIN_NAME="Lioc Management (CEO)"
ADMIN_ROLE="Chief Executive Officer"

# WhatsApp Business Integration
WHATSAPP_NUMBER=9007381804

# Corporate Contact Details
COMPANY_NAME="Lioc"
COMPANY_EMAIL=lioccalcutta@gmail.com
COMPANY_PHONE="+91 90073 81804"
COMPANY_SECONDARY_PHONE="+91 80134 51653"
COMPANY_ADDRESS="156, PGH Shah Road, Jadavpur, Kolkata - 700032, West Bengal, India"

# Automated Email Notifications (SMTP)
NOTIFICATION_EMAIL=lioccalcutta@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lioccalcutta@gmail.com
SMTP_PASSWORD=YOUR_16_CHAR_GMAIL_APP_PASSWORD
SMTP_TLS=True
EMAILS_ENABLED=True

# Anti-Spam Bot Protection (Cloudflare Turnstile)
# Get your production keys from Cloudflare Dashboard -> Turnstile
TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY
TURNSTILE_ENABLED=True
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Generative AI Chat Support (Optional - Add your Google Gemini or OpenAI API Key)
# When set, the Chat Support agent becomes generative and answers any question using your real product catalog
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Allowed CORS Origins (Comma-separated list of allowed frontend domains)
BACKEND_CORS_ORIGINS=http://localhost:3000,https://lioc.in,https://www.lioc.in
